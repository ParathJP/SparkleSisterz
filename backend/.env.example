# Server
PORT=5000

# Frontend origin(s) allowed to call this API.
# Comma-separated — include both localhost and the deployed Vercel URL.
FRONTEND_URL=http://localhost:3000

# Admin login credentials for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random string used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string

# WhatsApp Business number (country code, no + or spaces) e.g. 919876543210
WHATSAPP_NUMBER=

# MongoDB Atlas connection string
MONGODB_URI=

# Cloudinary (image hosting). Without these, uploads fall back to local disk,
# which is wiped on every restart on hosts like Render.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
